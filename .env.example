MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/
DB_NAME=AI-Summary-Pro
SECRET_KEY=change-me-to-a-long-random-string
SESSION_DAYS=7
# Set SESSION_COOKIE_SECURE=true when serving over https
SESSION_COOKIE_SECURE=false

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:0.6b
OLLAMA_API_KEY=
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT_SECONDS=600
OLLAMA_VISION_MODEL=

# Google Calendar OAuth (Web application credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/google-calendar/callback
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=

# auto = rapid -> paddle -> tesseract -> ollama
OCR_ENGINE=auto
TESSERACT_CMD=
MAX_UPLOAD_MB=25
WORKERS=2

SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@aisummary.app
# Generate with: python seed.py --hash   (keep the single quotes)
SEED_ADMIN_PASSWORD_HASH='scrypt:32768:8:1$...'
