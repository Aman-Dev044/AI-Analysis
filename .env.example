MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/
DB_NAME=AI-Summary-Pro
SECRET_KEY=change-me-to-a-long-random-string
SESSION_DAYS=7
# Set SESSION_COOKIE_SECURE=true when serving over https
SESSION_COOKIE_SECURE=false

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:0.6b
OLLAMA_API_KEY=
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT_SECONDS=600
OLLAMA_VISION_MODEL=
# Keep the model loaded between requests (avoids a slow reload on CPU servers)
OLLAMA_KEEP_ALIVE=30m

# ollama = use the model (falls back to rules if unreachable); rules = no AI server at all, every style is
# built from the document itself (instant on CPU)
AI_BACKEND=ollama
# smart = rule-extracted facts + short verified AI overview (fast on CPU). Others: short, detailed, bullets, ...
DEFAULT_MODE=smart
# false = Smart brief without any AI call (instant, fully rule-based)
SMART_AI_OVERVIEW=true
# extractive = pick key sentences of long docs instantly; mapreduce = model reads every part (slow on CPU)
LONG_DOC_STRATEGY=extractive

# Google Calendar OAuth (Web application credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/google-calendar/callback
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=

# auto = rapid -> tesseract -> ollama (paddle only when set explicitly: slow / can hang on Windows CPUs)
OCR_ENGINE=auto
TESSERACT_CMD=
# RapidOCR (PP-OCRv5 on ONNX Runtime): mobile = seconds per photo on a laptop CPU; server = ~20x slower
OCR_RAPID_MODEL=mobile
# Read Hindi (Devanagari) text with the Devanagari model instead of dropping it
OCR_HINDI=true
# PaddleOCR models (pip install -r requirements-ocr.txt)
OCR_PADDLE_DET_MODEL=PP-OCRv5_server_det
OCR_PADDLE_REC_MODEL=PP-OCRv5_server_rec
# 1 = read each image once (fast, best on the sample set). 2-4 = also read OpenCV versions (contrast, sharpened,
# enlarged) and keep the reading most versions agree on: ~4x slower, occasionally sharper on blurry photos
OCR_ENHANCE=true
OCR_MAX_PASSES=1
OCR_GOOD_CONFIDENCE=0.95
MAX_UPLOAD_MB=25
WORKERS=2

SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@aisummary.app
# Generate with: python seed.py --hash   (keep the single quotes)
SEED_ADMIN_PASSWORD_HASH='scrypt:32768:8:1$...'
