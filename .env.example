MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/
DB_NAME=AI-Summary-Pro
SECRET_KEY=change-me-to-a-long-random-string
SESSION_DAYS=7
# Set SESSION_COOKIE_SECURE=true when serving over https
SESSION_COOKIE_SECURE=false

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:0.6b
OLLAMA_API_KEY=
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT_SECONDS=600
OLLAMA_VISION_MODEL=
# Keep the model loaded between requests (avoids a slow reload on CPU servers)
OLLAMA_KEEP_ALIVE=30m

# ollama = use the model (falls back to rules if unreachable); rules = no AI server at all, every style is
# built from the document itself (instant on CPU)
AI_BACKEND=ollama
# smart = rule-extracted facts + short verified AI overview (fast on CPU). Others: short, detailed, bullets, ...
DEFAULT_MODE=smart
# false = Smart brief without any AI call (instant, fully rule-based)
SMART_AI_OVERVIEW=true
# extractive = pick key sentences of long docs instantly; mapreduce = model reads every part (slow on CPU)
LONG_DOC_STRATEGY=extractive

# auto = rapid -> paddle -> tesseract -> ollama
OCR_ENGINE=auto
TESSERACT_CMD=
MAX_UPLOAD_MB=25
WORKERS=2

SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@aisummary.app
# Generate with: python seed.py --hash   (keep the single quotes)
SEED_ADMIN_PASSWORD_HASH='scrypt:32768:8:1$...'
